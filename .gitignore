ml_pipeline/data/new_Dataset/
ml_pipeline/data/qdrant_db/
*.zip
*.tar
*.gz
*.csv
!*.dvc

# Exception rules: Allow essential CSV manifests, taxonomy files, and reports for project collaborators
!ml_pipeline/data/dataset_3crop_final_v4_split.csv
!ml_pipeline/config/taxonomy_v3.csv
!ml_pipeline/data/reports_v3/*.csv
!ml_pipeline/data/reports_final/*.csv
